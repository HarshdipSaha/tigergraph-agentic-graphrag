# TigerGraph Savanna (https://tgcloud.io). Create the graph first (Task 14), then create a secret for it in the Savanna UI.
TG_HOST=https://YOUR-WORKSPACE.i.tgcloud.io
TG_GRAPH=OlympicsRAG
TG_SECRET=
# Optional: only needed if your workspace requires user/password for GSQL DDL
TG_USERNAME=
TG_PASSWORD=

# LLM provider: groq (free tier) or anthropic
AGRAG_LLM_PROVIDER=groq
# One key or comma-separated project keys from the same Groq organization. GroqLLM rotates on
# per-key rate-limit/authentication errors; organization limits remain shared (see agrag/llm.py).
GROQ_API_KEY=
ANTHROPIC_API_KEY=
AGRAG_MODEL=openai/gpt-oss-20b
AGRAG_MAX_TOKENS=1024

# Embeddings
AGRAG_EMBED_MODEL=all-MiniLM-L6-v2

# Jev (TypeSafe AI) System One decision model (optional, for intelligent routing & tie-breaking)
JEV_ENABLED=false
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=5000
